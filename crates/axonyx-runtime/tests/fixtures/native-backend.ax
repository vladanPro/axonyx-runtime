route GET "/prepare" {
  data prepared = Native.call("content.prepare", {text: query.text})
  return json(prepared)
}

route GET "/invalid" {
  data prepared = Native.call("content.prepare", {text: 42})
  return json(prepared)
}

route GET "/unknown" {
  data prepared = Native.call("content.missing", {text: "hello"})
  return json(prepared)
}

route POST "/form" {
  data prepared = Native.call("content.prepare", {text: request.form.text})
  return json(prepared)
}

route GET "/nested" {
  data prepared = Native.call("content.batch", {items: [{text: query.text}], "meta:kind": "direct,prepare"})
  return json(prepared)
}

action PrepareContent(text: String) {
  data prepared = Native.call("content.prepare", {text: input.text})
  return prepared
}

route GET "/members" {
  data prepared = Native.call("content.batch", {items: [{text: query.text}], "meta:kind": "direct,prepare"})
  data selected = prepared.items[0]
  return json({text: selected.text, grouped: (prepared.items)[0].text, missing: prepared.absent.child, literal: "prepared.items[0].text"})
}

action CheckMember(text: String) {
  data prepared = Native.call("content.prepare", {text: input.text})
  require prepared.text != "" else invalid({text: "Required"})
  data copied = Native.call("content.prepare", {text: prepared.text})
  return copied.text
}

export type PostValidation {
  title: Bool
  slug: Bool
  body: Bool
  status: Bool
  titleError: String
}

export fn validatePost(title: String, slug: String, body: String, status: String) -> PostValidation {
  data titleValid = title != "" && title.length <= 160
  data slugValid = slug != "" && slug.length <= 120
  data bodyValid = body != "" && body.length <= 20000
  data statusValid = status == "draft" || status == "published"
  return { title: titleValid, slug: slugValid, body: bodyValid, status: statusValid, titleError: "Invalid title" }
}

export fn identityText(text: String) -> String {
  return text
}

export fn repeatText(text: String) -> String {
  data first = identityText(text)
  data second = identityText(text)
  return first + second
}

export fn countText(text: String) -> Int {
  return text.length
}

export fn countItems(items: String[]) -> Int {
  return items.length
}

export fn countDynamic(value: Json) -> Int {
  return value.length
}

export fn copyValidation(validation: PostValidation) -> PostValidation {
  return validation
}

export fn invalidValidation() -> PostValidation {
  return { title: "not a Bool", slug: true, body: true, status: true, titleError: "private details" }
}

action CheckPost(title: String, slug: String, body: String, status: String) {
  data validation = validatePost(input.title, input.slug, input.body, input.status)
  require validation["title"] else invalid({ title: validation["titleError"] })
  return validation
}

action ReuseHelper(text: String) {
  data first = identityText(input.text)
  data second = identityText(identityText(input.text))
  require identityText(input.text) != "" else invalid({text: "Required"})
  return { first: first, second: second, original: input.text, literal: "identityText(input.text)" }
}

route GET "/private/:id" -> Binary {
  require Auth.subject else forbidden()
  return Native.privateResponse("file.read", { id: params.id })
}

route GET "/private-empty" -> Binary {
  return Native.privateResponse("file.empty", {})
}

route GET "/private-missing" -> Binary {
  return Native.privateResponse("file.unknown", null)
}

route GET "/empty-native" {
  data value = Native.call("content.echo", { nested: {}, items: [] })
  return json(value)
}

route POST "/guard/:id" {
  require query.key == "fixture-only" && params.id == "allowed" else forbidden()
  require request.method == "POST" && request.headers.x_fixture == "yes" else forbidden()
  require query.mode in ["preview", "compiled"] else forbidden()
  return json({ key: query.key, literal: "query.key params.id request.method", size: query.key.length })
}

route GET "/short-guard" {
  require query.public == "yes" || query.key == "fixture-only" else forbidden()
  return json({ ok: true })
}

route GET "/account-guard" {
  require Auth.subject != "" else forbidden()
  return json({ subject: Auth.subject })
}

route GET "/and-guard" {
  require query.public == "yes" && query.key == "fixture-only" else forbidden()
  return json({ ok: true })
}
